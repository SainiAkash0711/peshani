# Copy to `.env.production` for a real deployment via docker-compose.prod.yml
# (`docker compose -f docker-compose.prod.yml --env-file .env.production up -d`).
# NEVER commit the real `.env.production` file - it is gitignored.
#
# This file serves TWO purposes for docker-compose.prod.yml:
#   1. Compose variable substitution (${DB_USER}, ${NEXT_PUBLIC_SITE_URL}, ...)
#   2. The api service's own `env_file:` (every apps/api/.env.example key
#      below must also be present here with real production values)
#
# See docs/PRODUCTION_RUNBOOK.md's "Environment Variables" and "Secret
# Management" sections for exactly how each of these should be sourced in a
# real deployment (ideally a secret manager, not a plain file on disk).

# ---- Database (used both by the postgres container and the api's DATABASE_URL) ----
DB_USER=peshani
DB_PASSWORD=REPLACE_WITH_A_REAL_RANDOM_PASSWORD
DB_NAME=peshani

# ---- Public URLs (baked into the web/admin builds at image-build time -
# see apps/web/Dockerfile and apps/admin/Dockerfile's ARG/ENV handling) ----
NEXT_PUBLIC_API_BASE_URL=https://your-production-domain.example/api/v1
NEXT_PUBLIC_SITE_URL=https://your-production-domain.example

# ---- Everything below mirrors apps/api/.env.example - copy that file's
# structure and set REAL production values here. Reproduced inline (rather
# than referencing the other file) because Docker Compose's `env_file:`
# needs one concrete file per service. ----
NODE_ENV=production
API_PORT=4000
CORS_ORIGINS=https://your-production-domain.example
TRUST_PROXY=1
SHUTDOWN_TIMEOUT_MS=10000
ENABLE_WORKERS=true
SLOW_REQUEST_THRESHOLD_MS=1000

JWT_ACCESS_SECRET=REPLACE_WITH_output_of_openssl_rand_hex_32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

MAX_VARIANT_COMBINATIONS=200
DEFAULT_STORE_NAME=Peshani
DEFAULT_STORE_CURRENCY=INR
DEFAULT_STORE_TIMEZONE=Asia/Kolkata

MAX_CART_ITEM_QUANTITY=100
GUEST_CART_EXPIRY_DAYS=30
USER_CART_EXPIRY_DAYS=90

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=https://your-production-domain.example
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SIGNED_URL_EXPIRY_SECONDS=3600

MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

RAZORPAY_KEY_ID=REPLACE_WITH_REAL_LIVE_KEY_ID
RAZORPAY_KEY_SECRET=REPLACE_WITH_REAL_LIVE_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_REAL_WEBHOOK_SECRET
RAZORPAY_MODE=live

CHECKOUT_RESERVATION_TTL_MINUTES=15

EMAIL_ENABLED=true
EMAIL_HOST=REPLACE_WITH_SMTP_HOST
EMAIL_PORT=587
EMAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
EMAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_FROM=no-reply@your-production-domain.example
EMAIL_FROM_NAME=Peshani
EMAIL_SECURE=true

THROTTLE_TEST_MODE=false
