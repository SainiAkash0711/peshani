# ---- Database ----
DB_USER=peshani
DB_PASSWORD=peshani_dev_password
DB_NAME=peshani
DATABASE_URL=postgresql://peshani:peshani_dev_password@localhost:5432/peshani?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Auth secrets (generate real random values for non-dev environments) ----
JWT_ACCESS_SECRET=change_me_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Catalog ----
MAX_VARIANT_COMBINATIONS=200

# ---- Storage (media) ----
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
# Reserved for a future S3-compatible provider - unused while STORAGE_PROVIDER=local.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SIGNED_URL_EXPIRY_SECONDS=3600

# ---- Media upload validation ----
MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---- Store defaults (seed data only - real values live in StoreSettings table) ----
DEFAULT_STORE_NAME=Peshani
DEFAULT_STORE_CURRENCY=INR
DEFAULT_STORE_TIMEZONE=Asia/Kolkata

# ---- Cart (Phase 4) ----
MAX_CART_ITEM_QUANTITY=100
GUEST_CART_EXPIRY_DAYS=30
USER_CART_EXPIRY_DAYS=90

# ---- Razorpay (Phase 5) - use TEST MODE credentials from the Razorpay dashboard ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# ---- Checkout (Phase 5) ----
CHECKOUT_RESERVATION_TTL_MINUTES=15

# ---- Rate limiting ----
# Never set this to true in a real deployment - it exists only so an e2e
# test run (which makes far more requests per minute than any real customer)
# doesn't trip rate limits meant for production traffic.
THROTTLE_TEST_MODE=false
