# Copy to apps/api/.env for local development, or supply these as real
# environment variables / an env_file in a deployment. Never commit a real
# .env with actual secrets - see docs/PRODUCTION_RUNBOOK.md's Secret
# Management section for how each of these should be sourced in production.

# ---- Database ----
DB_USER=peshani
DB_PASSWORD=peshani_dev_password
DB_NAME=peshani
DATABASE_URL=postgresql://peshani:peshani_dev_password@localhost:5432/peshani?schema=public

# ---- Redis (provisioned in docker-compose.yml; NOT required by application
# runtime code today - see the Phase 14 report's Redis Decision) ----
REDIS_URL=redis://localhost:6379

# ---- API ----
API_PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Server / proxy behavior (Phase 14) ----
# TRUST_PROXY: false (default) if this API is reachable directly; a small
# integer (e.g. 1) to trust exactly that many hops from the client when
# behind the bundled deploy/nginx/nginx.conf reverse proxy; or an explicit
# IP/CIDR (Express's native form) to trust a specific proxy address. Never
# set to `true` unless exactly one trusted proxy is guaranteed to be the
# only path to this process.
TRUST_PROXY=false
# How long a SIGTERM/SIGINT handler waits for in-flight requests/worker
# batches to finish before force-exiting.
SHUTDOWN_TIMEOUT_MS=10000
# Set to false on every instance except the one designated to run the
# outbox/email pollers in a future multi-instance deployment (§14). Leave
# true for a single-instance deployment (the default target today).
ENABLE_WORKERS=true
# Structured-request-log threshold - a request slower than this logs a
# SLOW_REQUEST warning line in addition to the normal request-completed line.
SLOW_REQUEST_THRESHOLD_MS=1000

# ---- Auth secrets ----
# Generate a real, random, >=32-character value for any non-local
# environment - e.g. `openssl rand -hex 32`. Startup validation
# (apps/api/src/main.ts) refuses to boot with a missing/short/placeholder
# value once NODE_ENV=production.
JWT_ACCESS_SECRET=change_me_to_a_real_random_secret_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ---- Catalog / store defaults (seed data only - real values live in the
# StoreSettings table once seeded) ----
MAX_VARIANT_COMBINATIONS=200
DEFAULT_STORE_NAME=Peshani
DEFAULT_STORE_CURRENCY=INR
DEFAULT_STORE_TIMEZONE=Asia/Kolkata

# ---- Cart ----
MAX_CART_ITEM_QUANTITY=100
GUEST_CART_EXPIRY_DAYS=30
USER_CART_EXPIRY_DAYS=90

# ---- Storage (media) ----
# 'local' is the only implemented provider today (see storage.module.ts) -
# setting STORAGE_PROVIDER=s3 fails fast at startup rather than silently
# falling back to local. See the Phase 14 report's Media Storage section
# for the documented persistent-volume-first production strategy.
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:4000
# Reserved for a future S3-compatible provider - unused while STORAGE_PROVIDER=local.
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_SIGNED_URL_EXPIRY_SECONDS=3600

MEDIA_MAX_UPLOAD_BYTES=10485760
MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# ---- Razorpay ----
# Use TEST MODE credentials from the Razorpay dashboard for any non-
# production environment; real live-mode credentials only in production,
# injected via a secret manager, never committed.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MODE=test

# ---- Checkout ----
CHECKOUT_RESERVATION_TTL_MINUTES=15

# ---- Notifications / Email ----
# EMAIL_ENABLED=false uses the logging-only EmailProvider fallback - safe
# for any environment without a real SMTP provider. Set to true and supply
# the rest of this block for real email delivery.
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@peshani.example
EMAIL_FROM_NAME=Peshani
EMAIL_SECURE=false

# ---- Rate limiting ----
# NEVER set to true in a real deployment - it exists only so an e2e test
# run (which makes far more requests per minute than any real customer)
# doesn't trip limits meant for production traffic.
THROTTLE_TEST_MODE=false
